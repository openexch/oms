<!-- CI-only Maven settings: resolve com.openexchange:cluster-kit from GitHub
     Packages using the workflow token. Local development does not need this
     file - `mvn install` in the cluster-kit checkout puts the artifact in
     ~/.m2 where this build finds it first.

     OMS needs its own copy rather than borrowing the checked-out engines':
     those settings are used to INSTALL match and assets, and this build then
     resolves cluster-kit for itself. Relying on whatever version the engines
     happened to drag in is how this build broke the day OMS asked for a
     version their main branches had not adopted yet. -->
<settings>
  <servers>
    <server>
      <id>github</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
  </servers>
  <profiles>
    <profile>
      <id>github</id>
      <repositories>
        <repository>
          <id>github</id>
          <url>https://maven.pkg.github.com/openexch/cluster-kit</url>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <activeProfiles><activeProfile>github</activeProfile></activeProfiles>
</settings>
