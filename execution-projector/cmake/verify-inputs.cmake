# Verifies the pinned ME journal schema and the cross-language fixtures against
# dependencies.lock. Runs at configure (include) and from the configure-guard test (cmake -P).
if(NOT DEFINED OE_PROJECTOR_DIR)
    message(FATAL_ERROR "OE_PROJECTOR_DIR is required")
endif()
file(READ "${OE_PROJECTOR_DIR}/dependencies.lock" oe_lock)

string(JSON oe_expected GET "${oe_lock}" me_journal_schema_sha256)
file(SHA256 "${OE_PROJECTOR_DIR}/schema/me-journal-schema.xml" oe_actual)
if(NOT oe_actual STREQUAL oe_expected)
    message(FATAL_ERROR "ME journal schema differs from dependencies.lock")
endif()
file(READ "${OE_PROJECTOR_DIR}/schema/me-journal-schema.xml" oe_schema)
if(NOT oe_schema MATCHES "<sbe:messageSchema[^>]*[ \t\r\n]id=\"4\"[ \t\r\n]+version=\"1\"")
    message(FATAL_ERROR "ME journal schema is not schemaId 4 version 1")
endif()

# The fixtures are produced by match's MeJournalFixtureDump at fixture_source_commit.
string(JSON oe_commit GET "${oe_lock}" fixture_source_commit)
if(oe_commit STREQUAL "PENDING-match-rc2-s1")
    message(WARNING "fixture_source_commit is the placeholder PENDING-match-rc2-s1; "
        "replace it with the signed match commit that commits the fixtures")
elseif(NOT oe_commit MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "fixture_source_commit is not a match commit sha: ${oe_commit}")
else()
    string(LENGTH "${oe_commit}" oe_commit_length)
    if(oe_commit_length LESS 7 OR oe_commit_length GREATER 40)
        message(FATAL_ERROR "fixture_source_commit is not a match commit sha: ${oe_commit}")
    endif()
endif()
string(JSON oe_expected GET "${oe_lock}" fixture_sha256sums_sha256)
set(oe_fixtures "${OE_PROJECTOR_DIR}/tests/fixtures")
file(SHA256 "${oe_fixtures}/SHA256SUMS" oe_actual)
if(NOT oe_actual STREQUAL oe_expected)
    message(FATAL_ERROR "Fixture SHA256SUMS differs from dependencies.lock")
endif()
file(STRINGS "${oe_fixtures}/SHA256SUMS" oe_sums)
set(oe_names "")
foreach(oe_line IN LISTS oe_sums)
    if(NOT oe_line MATCHES "^([0-9a-f]+)  ([A-Za-z0-9._-]+)$")
        message(FATAL_ERROR "Malformed fixture SHA256SUMS line: ${oe_line}")
    endif()
    set(oe_hash "${CMAKE_MATCH_1}")
    set(oe_name "${CMAKE_MATCH_2}")
    file(SHA256 "${oe_fixtures}/${oe_name}" oe_actual)
    if(NOT oe_actual STREQUAL oe_hash)
        message(FATAL_ERROR "Fixture differs from SHA256SUMS: ${oe_name}")
    endif()
    list(APPEND oe_names "${oe_name}")
endforeach()
set(oe_required java-command.first.bin java-command.retry.bin java-config.bin java-release.bin
    java-terminal.bin java-trade.bin)
if(NOT oe_names STREQUAL oe_required)
    message(FATAL_ERROR "Fixture SHA256SUMS must list exactly: ${oe_required}")
endif()
